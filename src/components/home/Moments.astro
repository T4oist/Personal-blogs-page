---
import { getCollection } from 'astro:content';
import dayjs from 'dayjs';
const moments = (await getCollection('moments')).sort((a,b) => b.data.date.getTime() - a.data.date.getTime()).slice(0,5);
---
<section class="moments-panel">
  <div class="section-line"><h2>Fragments</h2></div>
  {moments.length ? moments.map(moment => <div class="moment"><time datetime={moment.data.date.toISOString()}>{dayjs(moment.data.date).format('YYYY-MM-DD HH:mm')}</time><p>{moment.body}</p>{moment.data.mood && <span>{moment.data.mood}</span>}{moment.data.location && <small>{moment.data.location}</small>}</div>) : <p class="empty-state">—</p>}
</section>
