---
interface Props { headings:{depth:number;slug:string;text:string}[] }
const headings = Astro.props.headings.filter(h=>h.depth>1 && h.depth<4);
---
{headings.length>0 && <nav class="toc" aria-label="文章目录"><h2>INDEX</h2>{headings.map(heading=><a href={`#${heading.slug}`} data-toc data-depth={heading.depth}>{heading.text}</a>)}</nav>}
