---
import { getCollection } from 'astro:content';
import Icon from '@components/common/Icon.astro';
const posts = (await getCollection('blog', ({data}) => data.published !== false)).sort((a,b) => b.data.date.getTime()-a.data.date.getTime());
const topics = [...new Set(posts.flatMap(p => [p.data.category, ...p.data.tags]).filter(Boolean))];
---
<section data-filter-list data-param="tag" aria-label="文章列表">
  <div class="archive-tools"><label class="archive-search"><Icon name="search"/><input type="search" data-filter-query placeholder="Search…" aria-label="搜索文章" /></label><label class="archive-sort"><select data-sort aria-label="文章排序"><option value="newest">Newest</option><option value="oldest">Oldest</option></select></label></div>
  <div class="filter-toolbar"><div class="filter-chips" aria-label="按主题筛选"><button class="chip" data-filter="all" aria-pressed="true">All</button>{topics.map(topic => <button class="chip" data-filter={topic} aria-pressed="false">{topic}</button>)}</div></div>
  <div class="archive-caption"><span class="filter-count mono" role="status">{posts.length}</span></div>
  <div class="archive-list" data-sort-container>
    {posts.map((post,index) => <a class="archive-post" href={`/blog/${post.slug}`} data-filter-item data-date={post.data.date.getTime()} data-topics={JSON.stringify([post.data.category,...post.data.tags])} data-search={`${post.data.title} ${post.data.description || ''} ${post.body}`}>
      <span class="post-number mono">{String(index+1).padStart(2,'0')}</span><div class="post-summary"><span class="post-category">{post.data.category || '随笔'}</span><h2>{post.data.title}</h2>{post.data.description && <p>{post.data.description}</p>}<div class="post-tags">{post.data.tags.map(tag=><span>#{tag}</span>)}</div></div><div class="post-end"><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10).replaceAll('-','.')}</time><span class="post-open"><Icon name="external" size={24}/></span></div>
    </a>)}
  </div>
  <div class="empty-state filter-empty" hidden><p>No results.</p><button class="text-button" data-reset-filter>Reset ↗</button></div>
</section>
