<div class="cursor-ring" aria-hidden="true"></div>
<style is:global>
  .cursor-ring { position:fixed; left:0; top:0; width:24px; height:24px; border:1px solid var(--c-primary); border-radius:50%; pointer-events:none; z-index:90; opacity:0; transition:width .15s,height .15s,opacity .15s; }
  .cursor-ring.hovering { width:38px; height:38px; }
  @media (hover:none),(pointer:coarse),(prefers-reduced-motion:reduce) { .cursor-ring { display:none; } }
</style>
<script>
  let cleanup = () => {};
  function setupCursor() {
    cleanup();
    const ring=document.querySelector<HTMLElement>('.cursor-ring');
    const media=window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
    if (!ring) return;
    const controller=new AbortController();
    const {signal}=controller;
    let frame=0;
    const hide=()=>{ring.style.opacity='0';};
    window.addEventListener('pointermove',event=>{
      if (!media.matches || document.querySelector('dialog[open]')) {hide();return;}
      cancelAnimationFrame(frame);
      frame=requestAnimationFrame(()=>{
        ring.classList.toggle('hovering',event.target instanceof Element && !!event.target.closest('a,button,input,summary,select'));
        ring.style.transform=`translate(${event.clientX}px,${event.clientY}px) translate(-50%,-50%)`;
        ring.style.opacity='.45';
      });
    },{signal,passive:true});
    document.documentElement.addEventListener('pointerleave',hide,{signal});
    window.addEventListener('blur',hide,{signal});
    media.addEventListener('change',hide,{signal});
    cleanup=()=>{controller.abort();cancelAnimationFrame(frame);};
  }
  document.addEventListener('astro:page-load',setupCursor);
  document.addEventListener('astro:before-swap',()=>cleanup());
</script>
