---
import { readdirSync } from 'node:fs';
const tracks = readdirSync('public/music')
  .filter(name => /\.(mp3|m4a|ogg|wav|aac|flac)$/i.test(name))
  .sort((a,b) => a.localeCompare(b))
  .map(name => ({ title: name.replace(/\.[^.]+$/, ''), src: `/music/${encodeURIComponent(name)}` }));
---
<div class="header-music" transition:persist="header-music" data-music-player>
  <button class="music-toggle" data-music-toggle aria-label="播放音乐" title="Play" disabled={!tracks.length}>▷</button>
  <details class="music-disclosure">
    <summary aria-label="音乐播放器" title="Music"><span class="signal-mark" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span></summary>
    <div class="music-panel">
      <div class="music-panel-heading mono"><span>SIDE A</span><span>{String(tracks.length).padStart(2,'0')} TRACKS</span></div>
      <div class="music-turntable" aria-hidden="true" hidden={!tracks.length}>
        <div class="music-platter"><div class="music-vinyl"><span class="music-record-label"></span></div><span class="music-needle"></span></div>
        <div class="music-record-index"><span class="mono">NOW SPINNING</span><strong data-music-number>01</strong><div class="music-meter">{[.4,.8,.55,1,.65,.35,.85].map((height,index)=><i style={`--bar-height:${height};--bar-delay:${index*-.17}s`}></i>)}</div></div>
      </div>
      {tracks.length ? <>
        <label class="sr-only" for="music-track">选择曲目</label>
        <select id="music-track" data-music-track>{tracks.map(track => <option value={track.src}>{track.title}</option>)}</select>
      </> : <p class="music-empty mono">NO TRACKS YET</p>}
      <audio preload="metadata" src={tracks[0]?.src} hidden></audio>
      <div class="music-deck" hidden={!tracks.length}>
        <div class="music-time mono"><span data-music-time>0:00</span><span data-music-duration>—:—</span></div>
        <input class="music-range" data-music-seek type="range" min="0" max="100" value="0" step="0.1" aria-label="播放进度" disabled />
        <div class="music-transport">
          <button data-music-prev aria-label="上一首" title="Previous" disabled={tracks.length<2}>←</button>
          <button class="music-main-play" data-music-toggle aria-label="播放音乐" title="Play" disabled={!tracks.length}>▷</button>
          <button data-music-next aria-label="下一首" title="Next" disabled={tracks.length<2}>→</button>
        </div>
        <div class="music-volume"><button data-music-mute aria-label="静音" title="Mute" aria-pressed="false">♪</button><input class="music-range" data-music-volume type="range" min="0" max="1" step="0.01" value="1" aria-label="音量" /></div>
      </div>
      <div class="music-track-actions" hidden={!tracks.length}>
        <span class="music-status mono" role="status" aria-live="polite"></span>
      </div>
    </div>
  </details>
</div>
<script>
  function setupMusic() {
    const player = document.querySelector<HTMLElement>('[data-music-player]');
    if (!player || player.dataset.ready) return;
    player.dataset.ready = 'true';
    const audio = player.querySelector('audio')!;
    const toggles = player.querySelectorAll<HTMLButtonElement>('[data-music-toggle]');
    const seek = player.querySelector<HTMLInputElement>('[data-music-seek]')!;
    const volume = player.querySelector<HTMLInputElement>('[data-music-volume]')!;
    const mute = player.querySelector<HTMLButtonElement>('[data-music-mute]')!;
    const formatTime = (seconds: number) => Number.isFinite(seconds) ? `${Math.floor(seconds/60)}:${String(Math.floor(seconds%60)).padStart(2,'0')}` : '—:—';
    const paintRange = (input: HTMLInputElement) => input.style.setProperty('--range-fill', `${Number(input.value)/Number(input.max)*100}%`);
    const syncTime = () => {
      const valid = Number.isFinite(audio.duration) && audio.duration > 0;
      seek.disabled = !valid;
      seek.max = String(valid ? audio.duration : 100);
      seek.value = String(valid ? audio.currentTime : 0);
      seek.setAttribute('aria-valuetext', `${formatTime(audio.currentTime)} / ${formatTime(audio.duration)}`);
      player.querySelector('[data-music-time]')!.textContent = formatTime(audio.currentTime);
      player.querySelector('[data-music-duration]')!.textContent = formatTime(audio.duration);
      paintRange(seek);
      player.style.setProperty('--needle-progress', `${valid ? audio.currentTime/audio.duration*12 : 0}deg`);
    };
    const syncVolume = () => {
      volume.value = String(audio.muted ? 0 : audio.volume);
      const silent = audio.muted || audio.volume === 0;
      mute.textContent = silent ? '×' : '♪';
      mute.setAttribute('aria-pressed', String(silent));
      mute.setAttribute('aria-label', silent ? '取消静音' : '静音');
      mute.title = silent ? 'Unmute' : 'Mute';
      paintRange(volume);
    };
    const tracks = player.querySelector<HTMLSelectElement>('[data-music-track]');
    const status = player.querySelector<HTMLElement>('.music-status')!;
    const disclosure = player.querySelector('details')!;
    const sync = () => {
      const playing = !audio.paused && !audio.ended;
      player.classList.toggle('is-playing', playing);
      toggles.forEach(toggle => {
        toggle.textContent = playing ? 'Ⅱ' : '▷';
        toggle.setAttribute('aria-label', playing ? '暂停音乐' : '播放音乐');
        toggle.title = playing ? 'Pause' : 'Play';
      });
    };
    const play = async () => {
      status.textContent = '';
      try { await audio.play(); }
      catch { status.textContent = 'PLAYBACK UNAVAILABLE'; disclosure.open = true; }
      sync();
    };
    const selectTrack = (index: number, resume: boolean) => {
      if (!tracks || !tracks.options.length) return;
      tracks.selectedIndex = (index + tracks.options.length) % tracks.options.length;
      player.querySelector('[data-music-number]')!.textContent = String(tracks.selectedIndex+1).padStart(2,'0');
      player.classList.remove('is-changing');
      if (!document.documentElement.classList.contains('motion-paused') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        void player.offsetWidth;
        player.classList.add('is-changing');
      }
      audio.src = tracks.value;
      status.textContent = '';
      if (resume) void play();
    };
    toggles.forEach(toggle => toggle.addEventListener('click', () => { if (audio.paused) void play(); else audio.pause(); }));
    seek.addEventListener('input', () => { if (Number.isFinite(audio.duration)) audio.currentTime = Number(seek.value); syncTime(); });
    volume.addEventListener('input', () => { audio.volume = Number(volume.value); audio.muted = false; });
    mute.addEventListener('click', () => {
      const silent = audio.muted || audio.volume === 0;
      if (!audio.volume) audio.volume = 1;
      audio.muted = !silent;
    });
    ['timeupdate','loadedmetadata','durationchange','emptied'].forEach(event => audio.addEventListener(event, syncTime));
    audio.addEventListener('volumechange', syncVolume);
    syncTime(); syncVolume();
    tracks?.addEventListener('change', () => selectTrack(tracks.selectedIndex, !audio.paused));
    player.querySelector('[data-music-prev]')!.addEventListener('click', () => selectTrack((tracks?.selectedIndex ?? 0)-1, !audio.paused));
    player.querySelector('[data-music-next]')!.addEventListener('click', () => selectTrack((tracks?.selectedIndex ?? 0)+1, !audio.paused));
    audio.addEventListener('ended', () => selectTrack((tracks?.selectedIndex ?? 0)+1, true));
    audio.addEventListener('play', sync);
    audio.addEventListener('pause', sync);
    audio.addEventListener('error', () => { status.textContent = 'TRACK UNAVAILABLE'; sync(); });
    player.querySelector('.music-needle')!.addEventListener('animationend', () => player.classList.remove('is-changing'));
    player.addEventListener('keydown', event => { if (event.key === 'Escape') { disclosure.open = false; disclosure.querySelector('summary')!.focus(); } });
    document.addEventListener('pointerdown', event => { if (event.target instanceof Node && !player.contains(event.target)) disclosure.open = false; });
    document.addEventListener('astro:before-swap', () => { disclosure.open = false; });
  }
  document.addEventListener('astro:page-load', setupMusic);
</script>
<style is:global>
  .header-music { display: flex; align-items: center; gap: 6px; min-width: 110px; }
  .music-toggle,.music-disclosure>summary { display: grid; place-items: center; width: 44px; height: 52px; padding: 0; border: 0; background: transparent; color: inherit; cursor: pointer; }
  .music-toggle { font: 23px var(--mono); }
  .music-disclosure>summary { list-style: none; width: 60px; }
  .music-disclosure>summary .signal-mark { transform: scale(1.35); }
  .music-disclosure>summary::-webkit-details-marker { display: none; }
  .music-toggle:hover:not(:disabled),.music-disclosure>summary:hover { background: var(--c-text); color: var(--c-bg); }
  .header-music .signal-mark i { animation-play-state: paused; }
  .header-music.is-playing .signal-mark i { animation-play-state: running; }
  .music-panel { position: absolute; top: 100%; left: 86px; width: min(330px,calc(100vw - 24px)); padding: 20px; background: var(--c-bg); color: var(--c-text); border: 1px solid var(--c-text); box-shadow: 6px 6px 0 var(--c-text); z-index: 20; }
  .music-disclosure[open] .music-panel { animation: music-unfold .25s ease-out; transform-origin: top left; max-height: calc(100dvh - 110px); overflow-y: auto; }
  .music-turntable { display: flex; align-items: center; justify-content: space-between; gap: 22px; padding: 4px 0 22px; }
  .music-platter { position: relative; width: 148px; height: 148px; flex-shrink: 0; }
  .music-vinyl { display: grid; place-items: center; width: 100%; height: 100%; border-radius: 50%; border: 1px solid var(--c-text); background: repeating-radial-gradient(circle,var(--c-text) 0 3px,var(--c-bg) 3px 4px,var(--c-text) 4px 7px); animation: music-spin 7s linear infinite; animation-play-state: paused; }
  .music-vinyl::after { content: ''; position: absolute; inset: 8px; border-radius: 50%; background: conic-gradient(transparent 0 35deg,var(--c-bg) 48deg,transparent 65deg 210deg,var(--c-bg) 225deg,transparent 240deg); opacity: .2; }
  .music-record-label { width: 54px; height: 54px; background: var(--c-bg); border: 1px solid var(--c-text); border-radius: 50%; z-index: 1; }
  .music-needle { position: absolute; top: -3px; right: -2px; width: 8px; height: 86px; background: var(--c-text); border: 2px solid var(--c-bg); transform-origin: 50% 5px; transform: rotate(-12deg); transition: transform .6s cubic-bezier(.2,.8,.2,1); z-index: 2; }
  .music-needle::before { content: ''; position: absolute; top: -3px; left: -4px; width: 12px; height: 12px; background: var(--c-text); border-radius: 50%; }
  .music-needle::after { content: ''; position: absolute; bottom: -5px; left: -3px; width: 10px; height: 18px; background: var(--c-text); }
  .is-playing .music-needle { transform: rotate(calc(24deg + var(--needle-progress,0deg))); }
  .is-changing .music-needle { animation: music-cue .6s ease-in-out; }
  .music-record-index { flex: 1; min-width: 0; }
  .music-record-index>.mono { font-size: 8px; letter-spacing: .05em; }
  .music-record-index strong { display: block; font: 64px/1.2 var(--display); }
  .music-meter { display: flex; align-items: flex-end; gap: 4px; height: 22px; }
  .music-meter i { width: 4px; height: calc(22px * var(--bar-height)); background: var(--c-text); transform-origin: bottom; animation: music-meter .7s ease-in-out infinite alternate; animation-delay: var(--bar-delay); animation-play-state: paused; }
  .is-playing .music-disclosure[open] .music-vinyl,.is-playing .music-disclosure[open] .music-meter i { animation-play-state: running; }
  .music-transport button { transition: background .18s,color .18s,transform .18s; }
  .music-transport button:active:not(:disabled) { transform: scale(.92); }
  @keyframes music-spin { to { transform: rotate(360deg); } }
  @keyframes music-meter { from { transform: scaleY(.3); } to { transform: scaleY(1); } }
  @keyframes music-unfold { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes music-cue { 40% { transform: rotate(-20deg); } }
  .music-panel-heading,.music-track-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .music-panel-heading { font-size: 9px; margin-bottom: 18px; }
  .music-panel select { width: 100%; padding: 10px 0; margin-bottom: 18px; background: var(--c-bg); color: var(--c-text); border: 0; border-bottom: 1px solid var(--c-text); border-radius: 0; font: 13px var(--mono); }
  .music-time { display: flex; justify-content: space-between; font-size: 10px; font-variant-numeric: tabular-nums; }
  .music-range { --range-fill: 0%; appearance: none; -webkit-appearance: none; display: block; width: 100%; min-width: 0; height: 24px; margin: 4px 0; cursor: pointer; background: linear-gradient(to right,var(--c-text) var(--range-fill),var(--c-border) var(--range-fill)) center / 100% 2px no-repeat; border: 0; border-radius: 0; }
  .music-range::-webkit-slider-thumb { appearance: none; width: 8px; height: 14px; background: var(--c-text); border: 0; border-radius: 0; }
  .music-range::-moz-range-thumb { width: 8px; height: 14px; background: var(--c-text); border: 0; border-radius: 0; }
  .music-range:disabled { opacity: .35; cursor: default; }
  .music-transport { display: grid; grid-template-columns: 1fr 1.4fr 1fr; border: 1px solid var(--c-text); margin: 14px 0; }
  .music-transport button,.music-volume button { display: grid; place-items: center; height: 48px; border: 0; background: transparent; color: inherit; font: 22px var(--mono); }
  .music-transport .music-main-play { border-left: 1px solid var(--c-text); border-right: 1px solid var(--c-text); background: var(--c-text); color: var(--c-bg); }
  .music-transport button:hover:not(:disabled),.music-volume button:hover { background: var(--c-text); color: var(--c-bg); }
  .music-transport .music-main-play:hover { background: var(--c-bg); color: var(--c-text); }
  .music-volume { display: flex; gap: 12px; align-items: center; }
  .music-volume button { flex: 0 0 32px; height: 32px; font-size: 18px; }
  .music-track-actions:has(.music-status:empty) { display: none; }
  .music-track-actions { margin-top: 10px; }
  .music-status { font-size: 8px; }
  .music-empty { padding: 18px 0; font-size: 12px; }
  .head-console:has(.header-music) { display: flex; min-width: 0; padding: 0 12px; }
  @media(max-width:1000px) and (min-width:701px) { .head-console:has(.header-music) { flex: 0; } .main-nav a { padding: 0 12px; } }
  @media(max-width:700px) { .music-panel { top: 62px; left: 12px; } .head-console:has(.header-music) { padding: 0 6px; } }
</style>
