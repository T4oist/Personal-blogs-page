---
interface Props {
  repo?:string;repoId?:string;category?:string;categoryId?:string;mapping?:string;
  reactionsEnabled?:boolean;emitMetadata?:boolean;inputPosition?:string;theme?:string;lang?:string;
}
const {repo='T4oist/Personal-blogs-page',repoId='',category='Announcements',categoryId='',mapping='pathname',reactionsEnabled=true,emitMetadata=false,inputPosition='bottom',lang='zh-CN'} = Astro.props;
const config = {repo,'repo-id':repoId,category,'category-id':categoryId,mapping,'reactions-enabled':reactionsEnabled?'1':'0','emit-metadata':emitMetadata?'1':'0','input-position':inputPosition,lang};
---
<section class="comments-section" data-giscus-config={JSON.stringify(config)}>
  <h2>COMMENTS</h2>
  <div id="giscus-comments"></div>
  <p class="comments-help" id="giscus-status" role="status">…</p>
  <p class="comments-help"><a style="text-decoration:underline" href={`https://github.com/${repo}/discussions`} target="_blank" rel="noopener noreferrer">GitHub Discussions ↗</a></p>
</section>
<script>
  let cleanup = () => {};
  function setupComments() {
    cleanup();
    const section = document.querySelector<HTMLElement>('[data-giscus-config]');
    if (!section) return;
    const container = section.querySelector<HTMLElement>('#giscus-comments')!;
    const status = section.querySelector<HTMLElement>('#giscus-status')!;
    const config = JSON.parse(section.dataset.giscusConfig || '{}');
    const controller = new AbortController();
    const theme = () => document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    const sync = () => container.querySelector('iframe')?.contentWindow?.postMessage({giscus:{setConfig:{theme:theme()}}},'https://giscus.app');
    let started = false;
    const observer = new IntersectionObserver(entries => {
      if (!entries.some(entry=>entry.isIntersecting) || started) return;
      started = true; observer.disconnect();
      if (!config['repo-id'] || !config['category-id']) { status.textContent='评论暂未配置。'; return; }
      status.textContent='Loading…';
      const script = document.createElement('script');
      script.src='https://giscus.app/client.js'; script.async=true; script.crossOrigin='anonymous';
      for (const [key,value] of Object.entries(config)) script.setAttribute('data-'+key,String(value));
      script.setAttribute('data-theme',theme());
      script.addEventListener('load',()=>{status.textContent='Loading…';sync();},{signal:controller.signal});
      script.addEventListener('error',()=>{status.textContent='Connection unavailable.';},{signal:controller.signal});
      container.appendChild(script);
    },{rootMargin:'200px'});
    const mutation = new MutationObserver(() => {
      const frame=container.querySelector('iframe');
      if (frame) { frame.addEventListener('load',()=>{status.hidden=true;sync();},{signal:controller.signal}); mutation.disconnect(); }
    });
    mutation.observe(container,{childList:true,subtree:true});
    observer.observe(section);
    window.addEventListener('theme-change',sync,{signal:controller.signal});
    cleanup=()=>{controller.abort();observer.disconnect();mutation.disconnect();};
  }
  document.addEventListener('astro:page-load',setupComments);
  document.addEventListener('astro:before-swap',()=>cleanup());
</script>
