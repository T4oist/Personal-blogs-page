---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostList from '@components/blog/PostList.astro';
import Icon from '@components/common/Icon.astro';
---
<BaseLayout title="文字与记录 | T4oist">
  <div class="page-shell">
    <header class="page-heading archive-heading"><h1>NOTES</h1><button class="visual-link" data-random-post aria-label="随机文章" title="Shuffle"><Icon name="shuffle" size={24}/></button></header>
    <PostList />
  </div>
</BaseLayout>
