---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/common/Icon.astro';
import { SITE, SOCIAL_LINKS } from '@/config';
const topics = [
  {name:'HELLO', subject:'Just saying hello', symbol:'✳'},
  {name:'BUILD', subject:'An idea to build', symbol:'{ }'},
  {name:'MUSIC', subject:'A track worth sharing', symbol:'♫'},
];
const email = SOCIAL_LINKS.find(link => link.name === 'Email')!.href;
const interests = [
  {name:'CODE', symbol:'{ }'},
  {name:'SIM RACING', symbol:'◎'},
  {name:'PHOTOGRAPHY', symbol:'◉'},
  {name:'FPS', symbol:'⊕'},
  {name:'J-ROCK', symbol:'♫'},
  {name:'CINEMA', symbol:'▷'},
];
---
<BaseLayout title="About | T4oist">
  <div class="page-shell">
    <header class="page-heading"><h1>ABOUT</h1></header>
    <section class="profile-intro">
      <div class="profile-portrait"><img src={SITE.avatar} alt="T4oist 的头像" width="320" height="320"/></div>
      <div class="profile-copy"><h2>日进斗金</h2><p>我叫小道<br/>西安电子科技大学在读，学习全栈开发。<br/>写代码，拍照，听日摇。偶尔在宿舍跑几圈赛道。</p><a class="visual-link" href="#contact" aria-label="联系方式" title="Contact"><Icon name="external" size={28}/></a></div>
    </section>
    <section class="profile-section" id="interests"><div class="section-line"><h2 class="profile-label">INTERESTS</h2><span class="mono" aria-hidden="true">01</span></div>
      <ul class="interest-index" aria-label="我的兴趣">
        {interests.map((item,index) => <li class="interest-entry"><span class="interest-entry-symbol" aria-hidden="true">{item.symbol}</span><span class="interest-entry-copy"><strong>{item.name}</strong></span><span class="interest-entry-end"><span class="mono" aria-hidden="true">{String(index+1).padStart(2,'0')}</span></span></li>)}
      </ul>
    </section>
    <section class="profile-section"><div class="section-line"><h2 class="profile-label">TRACES</h2><span class="mono" aria-hidden="true">02</span></div><div class="journey">
      <a href="/blog/welcome"><time>2026.04</time><span><strong>第一篇。</strong></span><Icon name="external"/></a>
      <a href="/blog/racing-simulator-dorm"><time>2026.05</time><span><strong>宿舍里的赛道。</strong></span><Icon name="external"/></a>
      <a href="/blog/2026-05-14-self-directed-learning"><time>2026.05</time><span><strong>关于学习。</strong></span><Icon name="external"/></a>
    </div></section>
    <section class="profile-section"><div class="section-line"><h2 class="profile-label">TOOLS</h2><span class="mono" aria-hidden="true">03</span></div><div class="skill-cloud">{['JavaScript','TypeScript','Vue','React','Node.js','Python','Astro','Tailwind CSS'].map(skill => <span>{skill}</span>)}</div></section>
    <section class="contact-playground" id="contact">
      <div class="section-line"><span class="mono">04 / CONTACT</span><span class="contact-orbit" aria-hidden="true">✳</span></div>
      <div class="contact-layout">
        <h2>LET’S<br/><span>TALK.</span></h2>
        <div class="contact-letter" data-contact-letter>
          <div class="letter-top mono"><span>TO: T4OIST</span><span class="letter-postmark" aria-hidden="true">XI’AN<br/>CN</span></div>
          <div class="contact-topics" role="group" aria-label="Conversation topic">{topics.map((topic,index)=><button type="button" data-contact-topic data-subject={topic.subject} data-symbol={topic.symbol} aria-pressed={index===0?'true':'false'}><span class="mono" aria-hidden="true">0{index+1}</span>{topic.name}</button>)}</div>
          <div class="letter-subject"><label class="sr-only" for="contact-subject">Subject</label><input id="contact-subject" name="subject" value={topics[0].subject} maxlength="160" autocomplete="off"/><span data-topic-symbol aria-hidden="true">✳</span></div>
          <label class="sr-only" for="contact-message">Your message</label><textarea id="contact-message" name="message" rows="3" placeholder="What’s on your mind?" maxlength="2000"></textarea>
          <a class="letter-send" data-contact-email data-astro-reload data-address={email} href={email + '?subject=' + encodeURIComponent(topics[0].subject)} aria-describedby="email-fallback"><span>OPEN EMAIL</span><Icon name="external" size={28}/></a>
          <div class="letter-fallback" id="email-fallback" hidden>
            <p role="status">若没有打开邮件应用，可复制邮件内容，粘贴到你常用的邮箱中发送。</p>
            <address>{email.replace('mailto:','')}</address>
            <button class="button button-small" type="button" data-copy-letter>复制邮件内容</button>
          </div>
        </div>
      </div>
      <div class="contact-channels">{SOCIAL_LINKS.filter(link=>link.name!=='Email').map(link=><a href={link.href} target="_blank" rel="noopener noreferrer"><span>{link.name}</span><Icon name="external" size={22}/></a>)}</div>
      <div class="contact-address"><a href={email}>{email.replace('mailto:','')}</a><button class="visual-link" data-copy={email.replace('mailto:','')} aria-label="Copy email" title="Copy email"><Icon name="copy" size={20}/></button></div>
    </section>
  </div>
</BaseLayout>
