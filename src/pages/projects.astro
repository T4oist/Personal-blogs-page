---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/common/Icon.astro';
import { getCollection } from 'astro:content';
const projects = await getCollection('projects');
const categories = [
  {id:'web', label:'Web', projects:['blog']},
  {id:'mobile', label:'Mobile', projects:['danyilv']},
  {id:'desktop', label:'Desktop', projects:['suretype']},
];
---
<BaseLayout title="作品 | T4oist">
  <div class="page-shell">
    <header class="page-heading"><h1>WORK<span class="display-count">({String(projects.length).padStart(2,'0')})</span></h1></header>
    <section data-filter-list data-param="type" aria-label="项目列表">
      <div class="filter-toolbar"><div class="filter-chips" aria-label="按项目用途筛选"><button class="chip" data-filter="all" aria-pressed="true">All</button>{categories.map(category => <button class="chip" data-filter={category.id} aria-pressed="false">{category.label}</button>)}</div><span class="filter-count mono" role="status"></span></div>
      <div class="project-index">
        {projects.map((project,index) => <article class="project-entry" id={project.id} data-filter-item data-topics={JSON.stringify(categories.filter(category => category.projects.includes(project.id)).map(category => category.id))} data-search={`${project.data.name} ${project.data.description}`}>
          <span class="project-entry-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>
          <div class="project-content"><h2>{project.data.name}</h2><p>{project.data.description}</p><div class="tech-list">{project.data.tech.map(t => <span>{t}</span>)}</div><div class="project-actions">{(project.data.links || [{url:project.data.github || project.data.link || '/projects', label:'Open'}]).map(link => <a class="button button-small" href={link.url} target="_blank" rel="noopener noreferrer">{link.label === '在线预览' ? 'Live' : link.label}<Icon name="external" size={17}/></a>)}</div></div>
          <div class="project-mark" aria-hidden="true"><strong>{project.id === 'blog' ? 't4.' : project.id === 'suretype' ? '中' : '掸'}</strong></div>
        </article>)}
      </div>
      <p class="empty-state filter-empty" hidden>No results.<button class="text-button" data-reset-filter>Reset ↗</button></p>
    </section>
    <a class="next-room" href="/profile"><span>ABOUT<Icon name="external" size={32}/></span></a>
  </div>
</BaseLayout>
