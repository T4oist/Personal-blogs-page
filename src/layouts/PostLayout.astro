---
import BaseLayout from '@layouts/BaseLayout.astro';
import TableOfContents from '@components/blog/TableOfContents.astro';
import Comments from '@components/common/Comments.astro';
import { GISCUS_CONFIG } from '../config';
interface PostLink { slug: string; data: { title: string } }
interface Props { title:string; description?:string; date?:Date; tags?:string[]; readingTime?:string; headings?:{depth:number;slug:string;text:string}[]; prevPost?:PostLink|null; nextPost?:PostLink|null }
const { title,description,date,tags=[],readingTime,headings=[],prevPost=null,nextPost=null } = Astro.props;
---
<BaseLayout title={`${title} | T4oist`} description={description}>
  <progress class="reading-progress" id="reading-progress" max="100" value="0" aria-label="正文阅读进度"></progress>
  <article class="reading-shell">
    <div class="reading-top"><a class="visual-link" href="/blog" aria-label="返回文章列表" title="Notes">←</a><button class="button button-small" data-reading-size aria-pressed="false" aria-label="放大正文字号">Aa</button></div>
    <header class="reading-header"><h1>{title}</h1><div class="reading-meta">{date && <time datetime={date.toISOString()}>{date.toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric'})}</time>}{readingTime && <span>{readingTime}</span>}<span>by T4oist</span></div>{tags.length>0 && <div class="reading-tags">{tags.map(tag => <a href={`/blog?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div>}</header>
    {headings.some(h=>h.depth>1 && h.depth<4) && <details class="mobile-toc"><summary>Index</summary><TableOfContents headings={headings}/></details>}
    <div class="reading-grid"><div><div class="prose" id="reading-content"><slot /></div>
      {(prevPost || nextPost) && <nav class="post-pagination" aria-label="相邻文章">{prevPost ? <a href={`/blog/${prevPost.slug}`}><small>←</small><span>{prevPost.data.title}</span></a> : <div/>}{nextPost ? <a href={`/blog/${nextPost.slug}`}><small>→</small><span>{nextPost.data.title}</span></a> : <div/>}</nav>}
      <Comments {...GISCUS_CONFIG} />
    </div><aside><div><TableOfContents headings={headings}/><a class="visual-link" style="margin-top:25px" href="#main" aria-label="回到顶部" title="Top">↑</a></div></aside></div>
  </article>
</BaseLayout>
